# URL du webhook Discord dans lequel le bot poste les infos trafic
DISCORD_WEBHOOK_URL=

# Clé API PRIM (Ile-de-France Mobilités) - https://prim.iledefrance-mobilites.fr
IDFM_API_KEY=

# Réseau à surveiller (nom exact tel que dans le référentiel IDFM)
NETWORK_NAME=Marne et Brie

# Intervalle entre deux vérifications, en minutes
UPDATE_INTERVAL_MINUTES=10

# Mapping ligne -> emoji Discord personnalisé (au format JSON), un ID par ligne du réseau Marne et Brie.
# Sans entrée pour une ligne, le bot utilise le texte ":BusXXX:" par défaut.
